# =====================================================
# SwadBest Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================

# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── JWT ──
JWT_SECRET=<minimum-32-char-random-string>
JWT_EXPIRE=1d
REFRESH_TOKEN_EXPIRE=7d

# ── CORS (comma-separated list of allowed origins) ──
# Add localhost origins here for local development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Frontend URL (used in email links) ──
FRONTEND_URL=https://swadbest.com

# ── Cloudinary (image hosting) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BLOG_FOLDER=blogs
CLOUDINARY_BLOG_FEATURED_FOLDER=blogs/featured

# ── Razorpay (payment gateway) ──
RZ_KEY_ID=
RZ_KEY_SECRET=
RZ_WEBHOOK_SECRET=

# ── Resend (transactional email) ──
RESEND_API_KEY=

# ── Shiprocket (shipping integration) ──
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Home
SHIPROCKET_BASE=https://apiv2.shiprocket.in/v1/external
PICKUP_PINCODE=

# ── Admin ──
ADMIN_ROLE=admin

# ── File Upload ──
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
