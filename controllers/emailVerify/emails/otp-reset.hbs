<!-- emails/otp-reset.hbs -->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset OTP — SwadBest</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f4f1;font-family:Georgia,'Times New Roman',serif;-webkit-text-size-adjust:100%;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#f7f4f1;line-height:1px;">
    Your SwadBest password reset code is {{otp}}. Valid for 10 minutes.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f4f1;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background-color:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #ede8e3;box-shadow:0 8px 32px rgba(0,0,0,0.07);">

          <!-- Top accent -->
          <tr><td style="background:linear-gradient(90deg,#ea580c,#f97316);height:5px;font-size:0;">&nbsp;</td></tr>

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:36px 48px 28px;">
              <span style="font-family:Georgia,serif;font-size:28px;font-weight:700;letter-spacing:-0.5px;color:#1c1917;">
                <span style="color:#ea580c;">Swad</span>Best
              </span>
            </td>
          </tr>

          <!-- Icon -->
          <tr>
            <td align="center" style="padding:0 48px 24px;">
              <span style="font-size:36px;line-height:1;">🔐</span>
            </td>
          </tr>

          <!-- Heading -->
          <tr>
            <td align="center" style="padding:0 48px 12px;">
              <h1 style="margin:0;font-family:Georgia,serif;font-size:24px;font-weight:700;color:#1c1917;line-height:1.3;letter-spacing:-0.3px;">
                Reset your password
              </h1>
            </td>
          </tr>

          <!-- Subtext -->
          <tr>
            <td align="center" style="padding:0 48px 32px;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:15px;color:#57534e;line-height:1.7;">
                Use the code below to reset your SwadBest password.
                This code is valid for the next <strong style="color:#1c1917;">10 minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- OTP Box -->
          <tr>
            <td align="center" style="padding:0 48px 12px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                <tr>
                  <td align="center"
                    style="background-color:#fff7ed;border:2px dashed #fb923c;border-radius:16px;
                           padding:24px 48px;">
                    <span style="font-family:'Courier New',Courier,monospace;font-size:40px;
                                 font-weight:700;letter-spacing:12px;color:#ea580c;
                                 display:block;line-height:1;">
                      {{otp}}
                    </span>
                    <p style="margin:10px 0 0;font-family:Arial,sans-serif;font-size:12px;
                               color:#a8a29e;letter-spacing:0.5px;text-transform:uppercase;">
                      One-Time Password
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Timer note -->
          <tr>
            <td align="center" style="padding:16px 48px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                <tr>
                  <td style="background-color:#fef9f0;border:1px solid #fde68a;border-radius:8px;
                              padding:10px 20px;">
                    <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#92400e;">
                      ⏱ Expires in <strong>10 minutes</strong> · Do not share this code with anyone
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 48px;">
              <div style="height:1px;background-color:#f0ebe6;font-size:0;">&nbsp;</div>
            </td>
          </tr>

          <!-- Security note -->
          <tr>
            <td style="padding:20px 48px;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#78716c;line-height:1.6;">
                <strong style="color:#1c1917;">Didn't request this?</strong><br/>
                If you didn't ask to reset your password, your account is still safe.
                You can ignore this email — no changes have been made.
                If you're concerned, <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">contact our support team</a>.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:16px 48px 32px;background-color:#fafaf9;border-top:1px solid #f0ebe6;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:11px;color:#c4bfbb;">
                © {{year}} SwadBest · Eat Fresh, Eat Best · <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">support@swadbest.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
