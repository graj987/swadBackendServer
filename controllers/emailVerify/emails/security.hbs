<!-- emails/security.hbs -->
<!-- Used for: login-alert, password-changed, account-deleted -->
<!-- Variables: {{type}} "login"|"password"|"deleted", {{name}}, {{ip}}, {{device}}, {{time}}, {{year}} -->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}} — SwadBest</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f4f1;font-family:Georgia,'Times New Roman',serif;-webkit-text-size-adjust:100%;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#f7f4f1;line-height:1px;">
    {{preheader}}
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f4f1;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background-color:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #ede8e3;box-shadow:0 8px 32px rgba(0,0,0,0.07);">

          <!-- Top accent — orange for login/password, red for deleted -->
          <tr>
            <td style="background:{{accentColor}};height:5px;font-size:0;">&nbsp;</td>
          </tr>

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:36px 48px 20px;">
              <span style="font-family:Georgia,serif;font-size:28px;font-weight:700;letter-spacing:-0.5px;color:#1c1917;">
                <span style="color:#ea580c;">Swad</span>Best
              </span>
              <p style="margin:4px 0 0;font-family:Arial,sans-serif;font-size:11px;color:#a8a29e;letter-spacing:2px;text-transform:uppercase;">
                Security Notice
              </p>
            </td>
          </tr>

          <!-- Icon + heading -->
          <tr>
            <td align="center" style="padding:0 48px 20px;">
              <span style="font-size:40px;line-height:1;">{{icon}}</span>
              <h1 style="margin:16px 0 0;font-family:Georgia,serif;font-size:22px;font-weight:700;
                          color:#1c1917;line-height:1.3;letter-spacing:-0.3px;">
                {{heading}}
              </h1>
            </td>
          </tr>

          <!-- Body text -->
          <tr>
            <td style="padding:0 48px 24px;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:15px;color:#57534e;line-height:1.8;text-align:center;">
                {{{bodyText}}}
              </p>
            </td>
          </tr>

          <!-- Info card (login details — only shown for login alert) -->
          {{#if showDetails}}
          <tr>
            <td style="padding:0 48px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#fafaf9;border-radius:12px;border:1px solid #e7e5e4;overflow:hidden;">
                <tr>
                  <td style="padding:0;">
                    <!-- Row -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="padding:14px 20px;border-bottom:1px solid #f0ebe6;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;text-transform:uppercase;letter-spacing:0.8px;width:80px;">Device</td>
                              <td style="font-family:Arial,sans-serif;font-size:14px;color:#1c1917;font-weight:600;">{{device}}</td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:14px 20px;border-bottom:1px solid #f0ebe6;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;text-transform:uppercase;letter-spacing:0.8px;width:80px;">IP Address</td>
                              <td style="font-family:Arial,sans-serif;font-size:14px;color:#1c1917;font-weight:600;font-family:'Courier New',monospace;">{{ip}}</td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:14px 20px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;text-transform:uppercase;letter-spacing:0.8px;width:80px;">Time</td>
                              <td style="font-family:Arial,sans-serif;font-size:14px;color:#1c1917;font-weight:600;">{{time}}</td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{/if}}

          <!-- Warning / CTA -->
          <tr>
            <td style="padding:0 48px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#fef2f2;border-radius:10px;border:1px solid #fecaca;">
                <tr>
                  <td style="padding:14px 18px;">
                    <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#991b1b;line-height:1.6;">
                      ⚠️ <strong>Wasn't you?</strong> {{warningText}}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:20px 48px 32px;background-color:#fafaf9;border-top:1px solid #f0ebe6;">
              <p style="margin:0 0 6px;font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;line-height:1.6;">
                Need help? <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">support@swadbest.com</a>
              </p>
              <p style="margin:0;font-family:Arial,sans-serif;font-size:11px;color:#c4bfbb;">
                © {{year}} SwadBest · Eat Fresh, Eat Best
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
