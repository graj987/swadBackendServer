<!-- emails/verify-email.hbs -->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Verify Your Email — SwadBest</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f4f1;font-family:Georgia,'Times New Roman',serif;-webkit-text-size-adjust:100%;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#f7f4f1;line-height:1px;">
    Tap the button below to verify your email and activate your SwadBest account.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f4f1;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background-color:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #ede8e3;box-shadow:0 8px 32px rgba(0,0,0,0.07);">

          <!-- Top accent -->
          <tr><td style="background:linear-gradient(90deg,#ea580c,#f97316);height:5px;font-size:0;">&nbsp;</td></tr>

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:36px 48px 28px;">
              <span style="font-family:Georgia,serif;font-size:28px;font-weight:700;letter-spacing:-0.5px;color:#1c1917;">
                <span style="color:#ea580c;">Swad</span>Best
              </span>
            </td>
          </tr>

          <!-- Icon area -->
          <tr>
            <td align="center" style="padding:0 48px 24px;">
              <div style="width:64px;height:64px;background-color:#fff7ed;border-radius:50%;margin:0 auto;
                          display:flex;align-items:center;justify-content:center;border:2px solid #fed7aa;">
                <!-- Mail icon as text fallback -->
                <span style="font-size:28px;line-height:64px;">✉️</span>
              </div>
            </td>
          </tr>

          <!-- Heading -->
          <tr>
            <td align="center" style="padding:0 48px 16px;">
              <h1 style="margin:0;font-family:Georgia,serif;font-size:24px;font-weight:700;color:#1c1917;line-height:1.3;letter-spacing:-0.3px;">
                Confirm your email address
              </h1>
            </td>
          </tr>

          <!-- Body text -->
          <tr>
            <td style="padding:0 48px 32px;">
              <p style="margin:0 0 16px;font-family:Arial,sans-serif;font-size:15px;color:#57534e;line-height:1.7;text-align:center;">
                Welcome to SwadBest! We just need to verify that
                <strong style="color:#1c1917;">{{email}}</strong> belongs to you.
                Click the button below — it only takes a second.
              </p>
            </td>
          </tr>

          <!-- CTA Button -->
          <tr>
            <td align="center" style="padding:0 48px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="border-radius:12px;background-color:#ea580c;">
                    <a href="{{verifyLink}}" target="_blank"
                      style="display:inline-block;padding:16px 40px;font-family:Arial,sans-serif;
                             font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;
                             border-radius:12px;letter-spacing:0.2px;">
                      Verify My Email Address
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiry note -->
          <tr>
            <td align="center" style="padding:0 48px 28px;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#a8a29e;line-height:1.6;">
                This link expires in <strong style="color:#78716c;">24 hours</strong>.
              </p>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 48px;">
              <div style="height:1px;background-color:#f0ebe6;font-size:0;">&nbsp;</div>
            </td>
          </tr>

          <!-- Fallback link -->
          <tr>
            <td style="padding:20px 48px;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;line-height:1.6;">
                Button not working? Copy and paste this link into your browser:
              </p>
              <p style="margin:8px 0 0;font-family:Arial,sans-serif;font-size:12px;
                         color:#ea580c;word-break:break-all;line-height:1.5;">
                {{verifyLink}}
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:20px 48px 32px;background-color:#fafaf9;border-top:1px solid #f0ebe6;">
              <p style="margin:0 0 6px;font-family:Arial,sans-serif;font-size:12px;color:#a8a29e;">
                Didn't create an account? You can safely ignore this email.
              </p>
              <p style="margin:0;font-family:Arial,sans-serif;font-size:11px;color:#c4bfbb;">
                © {{year}} SwadBest · <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">support@swadbest.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
