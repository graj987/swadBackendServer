<!-- emails/welcome.hbs -->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to SwadBest, {{name}}!</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f4f1;font-family:Georgia,'Times New Roman',serif;-webkit-text-size-adjust:100%;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#f7f4f1;line-height:1px;">
    Your account is verified and ready. Welcome to the SwadBest family, {{name}}!
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f4f1;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background-color:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #ede8e3;box-shadow:0 8px 32px rgba(0,0,0,0.07);">

          <!-- Hero banner -->
          <tr>
            <td align="center"
              style="background:linear-gradient(135deg,#ea580c 0%,#f97316 60%,#fb923c 100%);
                     padding:48px 48px 40px;">
              <span style="font-family:Georgia,serif;font-size:32px;font-weight:700;
                           letter-spacing:-0.5px;color:#ffffff;">
                SwadBest
              </span>
              <p style="margin:12px 0 0;font-family:Arial,sans-serif;font-size:13px;
                         color:rgba(255,255,255,0.8);letter-spacing:2px;text-transform:uppercase;">
                Eat Fresh · Eat Best
              </p>
            </td>
          </tr>

          <!-- Welcome message -->
          <tr>
            <td style="padding:40px 48px 8px;">
              <h1 style="margin:0 0 16px;font-family:Georgia,serif;font-size:26px;font-weight:700;
                          color:#1c1917;line-height:1.3;letter-spacing:-0.3px;">
                Welcome aboard, {{name}} 🎉
              </h1>
              <p style="margin:0;font-family:Arial,sans-serif;font-size:15px;color:#57534e;line-height:1.8;">
                Your SwadBest account is now fully verified and active. We're thrilled to have you
                as part of our growing community of food lovers who believe in fresh, honest,
                quality products.
              </p>
            </td>
          </tr>

          <!-- What's next cards -->
          <tr>
            <td style="padding:28px 48px;">
              <p style="margin:0 0 16px;font-family:Arial,sans-serif;font-size:12px;font-weight:700;
                         color:#a8a29e;letter-spacing:1.5px;text-transform:uppercase;">
                What you can do now
              </p>

              <!-- Card 1 -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-bottom:12px;background-color:#fff7ed;border-radius:12px;border:1px solid #fed7aa;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                      <tr>
                        <td style="width:36px;vertical-align:top;">
                          <span style="font-size:20px;">🛒</span>
                        </td>
                        <td style="padding-left:12px;vertical-align:top;">
                          <p style="margin:0 0 4px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#1c1917;">Browse our products</p>
                          <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#78716c;line-height:1.5;">Explore our range of fresh, quality food products.</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Card 2 -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-bottom:12px;background-color:#f0fdf4;border-radius:12px;border:1px solid #bbf7d0;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                      <tr>
                        <td style="width:36px;vertical-align:top;">
                          <span style="font-size:20px;">🚚</span>
                        </td>
                        <td style="padding-left:12px;vertical-align:top;">
                          <p style="margin:0 0 4px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#1c1917;">Free delivery on your first order</p>
                          <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#78716c;line-height:1.5;">Your first order ships free — no minimum required.</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Card 3 -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#f8f7f6;border-radius:12px;border:1px solid #e7e5e4;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                      <tr>
                        <td style="width:36px;vertical-align:top;">
                          <span style="font-size:20px;">💬</span>
                        </td>
                        <td style="padding-left:12px;vertical-align:top;">
                          <p style="margin:0 0 4px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#1c1917;">We're here for you</p>
                          <p style="margin:0;font-family:Arial,sans-serif;font-size:13px;color:#78716c;line-height:1.5;">Any questions? Reach us at <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">support@swadbest.com</a></p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding:8px 48px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="border-radius:12px;background-color:#ea580c;">
                    <a href="{{shopUrl}}" target="_blank"
                      style="display:inline-block;padding:16px 40px;font-family:Arial,sans-serif;
                             font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:12px;">
                      Start Shopping →
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:20px 48px 32px;background-color:#fafaf9;border-top:1px solid #f0ebe6;">
              <p style="margin:0;font-family:Arial,sans-serif;font-size:11px;color:#c4bfbb;line-height:1.8;">
                © {{year}} SwadBest · Eat Fresh, Eat Best<br/>
                <a href="mailto:support@swadbest.com" style="color:#ea580c;text-decoration:none;">support@swadbest.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
