
{{!-- create a template to show on email with beautifull html and css --}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
        <h2 style="color: #333;">Email Verification</h2>
        <p>Thank you for registering with us! Please click the button below to verify your email address:</p>
        <a href="http://localhost:5000/api/users/verify-email?token={{token}}" style="display: inline-block; padding: 10px 20px; color: #fff; background-color: #28a745; text-decoration: none; border-radius: 5px;">Verify Email</a>
        <p style="margin-top: 20px;">If you did not sign up for this account, please ignore this email.</p>
        <p>Best regards,<br/>The Swadbest Team</p>
    </div>
            
</body>
</html>